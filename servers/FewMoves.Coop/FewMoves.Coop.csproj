<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Server/**/*.cs" />
    <Compile Include="../../Assets/Nectorial/SlideCore/**/*.cs" Link="SlideCore/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Nectorial/CoopCore/**/*.cs" Link="CoopCore/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Nectorial/RaidCore/**/*.cs" Link="RaidCore/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Assets/Nectorial/RecordCore/**/*.cs" Link="RecordCore/%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="../../Assets/Nectorial/Resources/CoopRooms/coop-c*.json" Link="CoopRooms/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
